# =============================================================================
# MediCode — Environment Variables Template
# =============================================================================
# Copy this file to .env and fill in your values.
# WARNING: .env contains secrets. Never commit it to version control.
#
# Quick start (dev):
#   cp .env.example .env  →  edit .env  →  docker compose up
#
# Quick start (dev, no Docker):
#   cp .env.example backend/.env  →  edit backend/.env
#   cd backend && pip install -r requirements.txt && uvicorn src.main:app
#   cd frontend && npm install && npm run dev
# =============================================================================

# ---- Environment ----
# Set to "development" or "production"
ENVIRONMENT=development

# ---- Database ----
# SQLite (dev):    sqlite+aiosqlite:///./data/medicode.db
# PostgreSQL (prod): postgresql+asyncpg://user:pass@host:5432/medicode
DATABASE_URL=sqlite+aiosqlite:///./data/medicode.db
DATABASE_SYNC_URL=sqlite:///./data/medicode.db

# PostgreSQL connection (only used in production compose)
POSTGRES_USER=medicode
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=medicode

# ---- Debug ----
# true: enable /docs, verbose logging, auto-seed demo data, relaxed CORS
# false: production mode — no docs, minimal logging, strict CORS
DEBUG=true

# ---- Security ----
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-to-a-random-64-char-string

# JWT token expiry (minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ---- LLM (Ollama) ----
# Model name (qwen2.5:3b, llama3.1, deepseek-r1:1.5b, etc.)
LLM_MODEL=qwen2.5:3b

# Ollama server URL. In Docker, use: http://ollama:11434
# For external/local Ollama, use: http://host.docker.internal:11434 (Windows/Mac)
# or http://localhost:11434 (Linux with host networking)
LLM_BASE_URL=http://localhost:11434

# ---- DRG ----
DRG_BASE_RATE=12000.0

# ---- CORS (comma-separated origins) ----
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost

# ---- Logging ----
LOG_LEVEL=INFO

# ---- Demo Users (dev only, ignored in production) ----
DEMO_ADMIN_PASSWORD=medicode2024
DEMO_CODER_PASSWORD=code123
DEMO_DOCTOR_PASSWORD=doc123

# ---- Gunicorn (production) ----
GUNICORN_WORKERS=4
GUNICORN_TIMEOUT=120

# ---- Ollama Sidecar (docker compose) ----
# Set to "true" to start Ollama alongside the app. Requires GPU for good perf.
OLLAMA_ENABLED=false
# Model to pull on first startup
OLLAMA_MODEL=qwen2.5:3b
