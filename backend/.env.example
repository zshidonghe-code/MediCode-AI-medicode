# MediCode Backend — Environment Variables
# Copy this file to .env and fill in your values.
# This file is a backend-local override of the root .env.

# ---- Environment ----
ENVIRONMENT=development

# ---- Database ----
# SQLite (dev):    sqlite+aiosqlite:///./data/medicode.db
# PostgreSQL (prod): postgresql+asyncpg://user:pass@host:5432/medicode
DATABASE_URL=sqlite+aiosqlite:///./data/medicode.db
DATABASE_SYNC_URL=sqlite:///./data/medicode.db

# ---- Debug ----
DEBUG=true

# ---- Security ----
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-to-a-random-64-char-string
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ---- LLM (Ollama) ----
LLM_MODEL=qwen2.5:3b
LLM_BASE_URL=http://localhost:11434
AUTO_SEED_DEMO_DATA=true

# ---- DRG ----
DRG_BASE_RATE=12000.0

# ---- Logging ----
LOG_LEVEL=INFO

# ---- Demo Users (dev only) ----
DEMO_ADMIN_PASSWORD=change-me
DEMO_CODER_PASSWORD=change-me
DEMO_DOCTOR_PASSWORD=change-me
